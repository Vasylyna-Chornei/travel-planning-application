<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="TOP_CENTER" styleClass="weather-container" stylesheets="@weather-tab.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.vasylyna.travelplanningapplication.controllers.WeatherTabController">

    <HBox alignment="CENTER" spacing="50" styleClass="header">
        <Button onAction="#onMainTab" styleClass="button" text="Головна" />
        <Button onAction="#onFinances" styleClass="button" text="Фінанси" />
        <Button onAction="#onJourneys" styleClass="button" text="Подорожі" />
        <Button styleClass="button" text="Чекліст речей" />
        <Button styleClass="button" text="Погода"/>
        <Button onAction="#onExit" styleClass="button" text="Вийти" />
    </HBox>

    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="cityInput" promptText="Щоб переглянути погоду, введіть місто..." styleClass="city-input"/>
        <Button text="🔍" onAction="#onSearchCity" styleClass="search-button"/>
    </HBox>

    <VBox fx:id="weatherBox" spacing="5" alignment="CENTER" visible="false" styleClass="weather-info-box">
        <Label styleClass="weather-header-label" text="Прогноз погоди на даний час у місті"/>
        <Label fx:id="cityLabel" styleClass="weather-city-label"/>
        <Label fx:id="tempLabel"/>
        <Label fx:id="descLabel" styleClass="weather-desc-label"/>
    </VBox>

    <HBox fx:id="forecastBox" spacing="10" alignment="CENTER" visible="false"/>
</VBox>
