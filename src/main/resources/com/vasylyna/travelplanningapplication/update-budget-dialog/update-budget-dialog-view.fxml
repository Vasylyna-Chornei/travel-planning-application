<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>

<VBox alignment="CENTER" spacing="15.0" styleClass="vbox" stylesheets="@update-budget-dialog.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.vasylyna.travelplanningapplication.controllers.UpdateBudgetController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Введіть суму" />
    <TextField fx:id="amountField" promptText="Введіть числове значення (грн)"/>

    <Label text="Виберіть категорію"/>
    <ComboBox fx:id="categoryComboBox">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="Транспорт"/>
                <String fx:value="Проживання"/>
                <String fx:value="Харчування"/>
                <String fx:value="Екскурсії"/>
                <String fx:value="Квитки (музеї, театри)"/>
                <String fx:value="Покупки сувенірів"/>
                <String fx:value="Розваги"/>
                <String fx:value="Страхування"/>
                <String fx:value="Зв'язок та інтернет"/>
                <String fx:value="Оренда авто"/>
                <String fx:value="Паливо"/>
                <String fx:value="Обмін валюти"/>
                <String fx:value="Віза та документи"/>
                <String fx:value="Перевезення багажу"/>
                <String fx:value="Дитячі розваги"/>
                <String fx:value="Аптека / ліки"/>
                <String fx:value="Особисті покупки"/>
                <String fx:value="Плата за багажне зберігання"/>
                <String fx:value="Інше"/>
            </FXCollections>
        </items>
    </ComboBox>

    <Label text="Додайте опис:"/>
    <TextField fx:id="descriptionField" promptText="Опишіть витрати"/>

    <Region/>

    <Button text="Підтвердити" onAction="#handleConfirm"/>
</VBox>
