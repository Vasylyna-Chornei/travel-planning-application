<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.HBox?>
<VBox alignment="TOP_CENTER" spacing="10.0" styleClass="vbox" stylesheets="@main-tab.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.vasylyna.travelplanningapplication.controllers.MainTabController">


    <Label text="Trip Planner" styleClass="title-label"/>
    <HBox spacing="50" styleClass="hbox" >
        <Button fx:id="mainTabButton" styleClass="button" text="Головна"/>
        <Button fx:id="financesButton" styleClass="button" onAction="#onFinances" text="Фінанси"/>
        <Button fx:id="plansButton" styleClass="button" text="Подорожі" />
        <Button fx:id="toTakeButton" styleClass="button" text="Чекліст речей" />
        <Button fx:id="weatherButton" onAction="#onWeather" styleClass="button" text="Погода"/>
        <Button fx:id="exitButton" onAction="#onExit" styleClass="button" text="Вийти" />
    </HBox>

    <VBox fx:id="mapVBox" styleClass="map-vbox">

    </VBox>
</VBox>
