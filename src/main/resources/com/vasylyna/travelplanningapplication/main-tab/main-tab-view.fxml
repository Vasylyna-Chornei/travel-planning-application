<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@main-tab.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vasylyna.travelplanningapplication.controllers.MainTabController">
    <VBox alignment="TOP_CENTER" spacing="10.0">

        <Label text="Trip Planner" />
        <HBox spacing="50" styleClass="header">
            <Button styleClass="button" text="Головна" />
            <Button onAction="#onFinances" styleClass="button" text="Фінанси" />
            <Button onAction="#onJourneys" styleClass="button" text="Подорожі" />
            <Button onAction="#onChecklist" styleClass="button" text="Чекліст речей" />
            <Button onAction="#onWeather" styleClass="button" text="Погода" />
            <Button onAction="#onExit" styleClass="button" text="Вийти" />
        </HBox>

        <VBox fx:id="mapVBox" styleClass="map-vbox">

        </VBox>
    </VBox>

    <AnchorPane pickOnBounds="false">
        <Label fx:id="countryCountLabel" layoutX="434.0" layoutY="528.0" styleClass="country-count-label" text="0/0" AnchorPane.bottomAnchor="104.79999999999995" AnchorPane.rightAnchor="315.6" />
    </AnchorPane>
</StackPane>
